define                  = -DPOSRES -DPOSRES_FC_LIP=50.0
integrator              = md
dt                      = 0.002
nsteps                  = 500000
nstxtcout               = 5000
;nstvout                 = 5000
;nstfout                 = 5000
nstcalcenergy           = 500
nstenergy               = 2500
nstlog                  = 2500
;
cutoff-scheme           = Verlet
nstlist                 = 20
rlist                   = 1.2
coulombtype             = pme
rcoulomb                = 1.2
vdwtype                 = Cut-off
vdw-modifier            = Force-switch
rvdw_switch             = 1.0
rvdw                    = 1.2
;
tcoupl                  = v-rescale ;berendsen
tc_grps                 = SYSTEM
tau_t                   = 1.0
ref_t                   = 320 ;310
;
pcoupl                  = c-rescale ;berendsen
pcoupltype              = isotropic
tau_p                   = 5.0
compressibility         = 4.5e-5
ref_p                   = 1.0
;
constraints             = h-bonds
constraint_algorithm    = LINCS
continuation            = no ;yes
;
nstcomm                 = 100
comm_mode               = linear
comm_grps               = SYSTEM
;
refcoord_scaling        = com

