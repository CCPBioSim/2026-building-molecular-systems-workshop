define                  = -DPOSRES -DPOSRES_FC_LIP=20.0
integrator              = md
dt                      = 0.002
nsteps                  = 5000000
nstxtcout               = 50000
;nstvout                 = 50000
;nstfout                 = 50000
nstcalcenergy           = 500
nstenergy               = 10000
nstlog                  = 10000
;
cutoff-scheme           = Verlet
nstlist                 = 20
rlist                   = 1.2
coulombtype             = pme
rcoulomb                = 1.2
vdwtype                 = Cut-off
vdw-modifier            = Force-switch
rvdw_switch             = 1.0
rvdw                    = 1.2
;
;tcoupl                  = berendsen
;tc_grps                 = SYSTEM
;tau_t                   = 1.0
;ref_t                   = 310
;
;pcoupl                  = berendsen
;pcoupltype              = isotropic
;tau_p                   = 5.0
;compressibility         = 4.5e-5
;ref_p                   = 1.0
;
tcoupl                  = v-rescale ;nose-hoover ;berendsen
tc_grps                 = SYSTEM
tau_t                   = 1.0
ref_t                   = 320 ;310
;
pcoupl                  = c-rescale ;Parrinello-Rahman ;berendsen
pcoupltype              = isotropic
tau_p                   = 5.0
compressibility         = 4.5e-5
ref_p                   = 1.0
;
;pcoupl                  = Parrinello-Rahman ;berendsen
;pcoupltype              = anisotropic
;tau_p                   = 5.0  5.0 5.0
;compressibility         = 4.5e-5 4.5e-5 4.5e-5
;ref_p                   = 1.0 1.0 1.0
;
constraints             = h-bonds
constraint_algorithm    = LINCS
continuation            = no ;yes
;
nstcomm                 = 100
comm_mode               = linear
comm_grps               = SYSTEM
;
refcoord_scaling        = com

